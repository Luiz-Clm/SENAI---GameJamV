  m_Script: {fileID: 11500000, guid: 6616f96382f1d174ea223febaef0ce0c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SpellGlide.ComicIntroManager
  comicSprites:
  - {fileID: -855298285791758126, guid: 73933f8dab7a7b54abdd666327992d91, type: 3}
  - {fileID: 6937817954938267909, guid: a8660db42f6fafc409c29fa072faec4d, type: 3}
  - {fileID: -6470460504253458178, guid: 60450c26513324441bebcc5c5da6095c, type: 3}
  - {fileID: -4178046375966092550, guid: 32b2c4bd401ce9e4b9e4c5867c6fbbf4, type: 3}
  - {fileID: 4130640169021434097, guid: 8f1d142d8b07e824c8e22001f9025cab, type: 3}
  - {fileID: 3465286685962602723, guid: 12ae0b748e9b5e646a155c668f74a32a, type: 3}
  comicTexts:
  - "Gilbert \xE9 um mago anci\xE3o que guarda a entrada desta masmorra h\xE1 s\xE9culos.
    Sua rotina sempre foi tranquila: vigiar os arredores e orientar os jovens aventureiros
    que por ali passavam. "
  - "Por\xE9m, em um dia aparentemente comum, uma figura misteriosa surge das sombras
    e sela a sa\xEDda com uma poderosa magia das trevas, prendendo Gilbert l\xE1
    dentro. "
  - "Sem hesitar, Gilbert conjura seus feiti\xE7os para quebrar o selo... mas a magia
    do desconhecido \xE9 forte demais. A sa\xEDda est\xE1 completamente bloqueada."
  - "De repente, um brilho distante surge no fundo da caverna. Se n\xE3o h\xE1 como
    voltar, o \xFAnico caminho para desfazer esse selo \xE9 ir em frente."
  - Decidido a encarar os perigos que o aguardam, o velho mago pega sua vassoura
    e se prepara para a jornada.
  - "E assim, Gilbert adentra as profundezas da masmorra. A verdadeira aventura come\xE7a
    agora!"
  fadeInDuration: 1
  fadeOutDuration: 0.8
  panelDisplayDuration: 10
  typewriterSpeed: 0.04
  nextSceneName: Fase
