--- !u!114 &174841603
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 174841601}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5d46457c72efd554d8591be382052212, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::WitchShmup.UI.EvolutionUI
  defaultNodeSize: {x: 68, y: 68}
  defaultIconSize: {x: 40, y: 40}
  lineThickness: 5
  treeAreaSize: {x: 1500, y: 1800}
  treeNodes:
  - id: vit
    displayName: "1. Cora\xE7\xE3o Refor\xE7ado"
    description: "Cada n\xEDvel aumenta sua vida m\xE1xima em um cora\xE7\xE3o."
    effectText: "+1 Cora\xE7\xE3o de Vida M\xE1xima por n\xEDvel"
    requirementId: 
    maxLevel: 5
    cost: 1
    customIcon: {fileID: 0}
    canvasPos: {x: 0, y: -320}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: vel
    displayName: 2. Vassoura Leve
    description: A vassoura corta o ar com leveza, facilitando esquivas.
    effectText: +10% Velocidade de Movimento
    requirementId: vit
    maxLevel: 1
    cost: 2
    customIcon: {fileID: 0}
    canvasPos: {x: 0, y: -220}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: f_cha
    displayName: 3. Chama Viva
    description: "Intensifica o fogo m\xE1gico disparado pelo cajado."
    effectText: +15% de Dano de Fogo
    requirementId: vel
    maxLevel: 1
    cost: 2
    customIcon: {fileID: 0}
    canvasPos: {x: -90, y: -110}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: f_que
    displayName: "4. Brasa Cont\xEDnua"
    description: Inimigos atingidos ardem continuamente ao longo de 2s.
    effectText: "Dano Cont\xEDnuo por 2s (DoT)"
    requirementId: f_cha
    maxLevel: 1
    cost: 3
    customIcon: {fileID: 0}
    canvasPos: {x: -90, y: 0}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: f_are
    displayName: "5. Impacto T\xE9rmico"
    description: "O impacto do fogo causa uma detona\xE7\xE3o curta ao redor."
    effectText: "Dano em \xC1rea Residual (AoE)"
    requirementId: f_que
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: -90, y: 110}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: f_sup
    displayName: "6. Combust\xE3o Espalhada"
    description: Se o monstro queimar e morrer, espalha brasa aos vizinhos.
    effectText: Espalha Chamas em Cadeia
    requirementId: f_are
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: -70, y: 220}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: t_cad
    displayName: "7. Cad\xEAncia Constante"
    description: Acelera a velocidade de recarga e disparo do mago.
    effectText: +12% de Velocidade de Ataque
    requirementId: f_cha
    maxLevel: 1
    cost: 2
    customIcon: {fileID: 0}
    canvasPos: {x: -240, y: -40}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: t_hit
    displayName: 8. Cajado Ampliado
    description: "Aumenta a \xE1rea de contato de todos os proj\xE9teis."
    effectText: "+20% no Tamanho dos Proj\xE9teis"
    requirementId: t_cad
    maxLevel: 1
    cost: 3
    customIcon: {fileID: 0}
    canvasPos: {x: -280, y: 70}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: t_dup
    displayName: 9. Tiro Duplo Angular
    description: "A cada 3 disparos, solta um segundo tiro em leque de 15\xBA."
    effectText: Disparo Duplo a cada 3 tiros
    requirementId: t_hit
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: -280, y: 180}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: t_rit
    displayName: "10. Ritmo B\xE9lico"
    description: Atirar continuamente por 2s concede um surto de rapidez.
    effectText: "+10% de Cad\xEAncia em Combate"
    requirementId: t_dup
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: -210, y: 280}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: g_lan
    displayName: 11. Frio Cortante
    description: "O tiro de gelo penetra o ar com l\xE2minas afiadas."
    effectText: +15% de Dano de Gelo
    requirementId: vel
    maxLevel: 1
    cost: 2
    customIcon: {fileID: 0}
    canvasPos: {x: 90, y: -110}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: g_con
    displayName: 12. Resfriamento
    description: O gelo arrefece os movimentos dos monstros inimigos.
    effectText: "Lentid\xE3o de 20% por 1,5s"
    requirementId: g_lan
    maxLevel: 1
    cost: 3
    customIcon: {fileID: 0}
    canvasPos: {x: 90, y: 0}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: g_que
    displayName: 13. Quebra-Gelo
    description: "Causa dano devastador contra alvos que j\xE1 estejam lentos."
    effectText: +25% de Dano em Alvos Lentos
    requirementId: g_con
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: 90, y: 110}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: g_per
    displayName: 14. Gelo Perfurante
    description: Se o tiro de gelo abater o primeiro monstro, ele segue em frente.
    effectText: "Perfura\xE7\xE3o em Golpe Letal"
    requirementId: g_que
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: 70, y: 220}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: v_inv
    displayName: "15. Recupera\xE7\xE3o R\xE1pida"
    description: "Aumenta o tempo que o mago fica imune ap\xF3s sofrer dano."
    effectText: +0,5s de Invulnerabilidade
    requirementId: g_lan
    maxLevel: 1
    cost: 2
    customIcon: {fileID: 0}
    canvasPos: {x: 240, y: -40}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: v_cor
    displayName: "16. Cora\xE7\xE3o Adicional"
    description: "Fortalece permanentemente a ess\xEAncia vital do feiticeiro."
    effectText: "+1 Cora\xE7\xE3o de Vida M\xE1xima"
    requirementId: v_inv
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: 280, y: 70}
    customNodeSize: {x: 0, y: 0}
    customIconSize: {x: 0, y: 0}
  - id: v_pul
    displayName: 17. Pulso Protetor
    description: "Ao levar um golpe, dissipa os proj\xE9teis inimigos colados em
      voc\xEA."
    effectText: Apaga Balas ao Sofrer Dano
    requirementId: v_cor
    maxLevel: 1
    cost: 4
    customIcon: {fileID: 0}
    canvasPos: {x: 280, y: 180}
